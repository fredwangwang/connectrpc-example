export PATH := $(HOME)/go/bin:$(PATH)

BUILD_DIR := build

.PHONY: tools gen build build-docker server client-rs client-curl

tools:
	go install github.com/bufbuild/buf/cmd/buf@latest
	go install google.golang.org/protobuf/cmd/protoc-gen-go@latest
	go install connectrpc.com/connect/cmd/protoc-gen-connect-go@latest

# Go code via buf; Rust code is generated by client-rs/build.rs
gen:
	buf lint && buf generate

build:
	mkdir -p $(BUILD_DIR)
	cd server && go build -o ../$(BUILD_DIR)/server .
	cd client-rs && cargo build --release -q
	cp client-rs/target/release/client $(BUILD_DIR)/client-rs
	cp client-curl/client.sh $(BUILD_DIR)/client-curl.sh

# Build server + clients in Docker (no Go/Rust/buf/protoc needed on the host).
# Same outputs as `make build`. Requires Docker with BuildKit.
build-docker:
	mkdir -p $(BUILD_DIR)
	docker build --target artifacts --output type=local,dest=$(BUILD_DIR) .

server:
	cd server && go run . --addr localhost:8080

# Usage: make client-rs ARGS="--mode grpc --cmd subscribe"
client-rs:
	cd client-rs && cargo run -q -- $(ARGS)

# Usage: make client-curl ARGS="--cmd subscribe --max 3"   (HTTP/1.1 only)
client-curl:
	./client-curl/client.sh $(ARGS)
